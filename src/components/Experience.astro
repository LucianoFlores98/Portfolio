---
import Point from '../components/icons/Point.astro';

interface Props {
    date: string,
    title: string,
    company: string,
    linkCompany: string
    description: string,
    devMilestones: Array<string | { title: string, details: string[] }>,
    otherMilestones?: Array<string | { title: string, details: string[] }>,
    link?: string
}

const {title, description, devMilestones, otherMilestones, date, company, linkCompany} = Astro.props;
---

<div class="w-3 h-3 bg-gray-200 rounded-full mt-2 -start-1.5 border border-white dot"></div>
<time class="mb-1 text-md font-normal leading-none text-sky-200/90">{date}</time>
<h3 class="text-lg font-semibold text-yellow-200 mt-2">
    {title}
    <a class="text-bold text-yellow-250" href={linkCompany}>
        {company}
    </a>
</h3>
<p set:html={description} class="mb-4 text-base font-normal text-gray-200 text-balance [&>b]:text-cyan-200" />

{devMilestones && (
    <>
        <h3 class="my-5 text-sm font-normal leading-none text-sky-200/80">Hitos developer</h3>
        <ul class="List">      
            {devMilestones.map((milestone, index) => {
                const isExpandable = typeof milestone === 'object' && milestone.details;
                const content = typeof milestone === 'string' ? milestone : milestone.title;
                
                return (
                    <li class="mb-3">
                        <div class="flex">
                            <Point class="mr-2 mt-1 size-4 min-w-max"/>
                            <div class="flex-1">
                                {isExpandable ? (
                                    <button 
                                        class="milestone-toggle text-left w-full group"
                                        data-target={`dev-${index}`}
                                        type="button"
                                    >
                                        <span set:html={content} class="text-base font-normal text-gray-200 text-balance group-hover:text-sky-200 transition-colors"/>
                                        <svg class="inline-block ml-2 w-4 h-4 transition-transform duration-200 chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </button>
                                ) : (
                                    <span set:html={content} class="text-base font-normal text-gray-200 text-balance"/>
                                )}
                                
                                {isExpandable && (
                                    <ul id={`dev-${index}`} class="sublist hidden mt-2 ml-4 space-y-2">
                                        {milestone.details.map((detail) => (
                                            <li class="flex">
                                                <span class="mr-2 text-sky-200/60">→</span>
                                                <span set:html={detail} class="text-sm text-gray-300 text-balance"/>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    </li>
                );
            })}
        </ul>
    </>
)}

{otherMilestones && (
    <>
        <h3 class="my-5 text-sm font-normal leading-none text-sky-200/80">Otros Hitos</h3>
        <ul class="List">      
            {otherMilestones.map((milestone, index) => {
                const isExpandable = typeof milestone === 'object' && milestone.details;
                const content = typeof milestone === 'string' ? milestone : milestone.title;
                
                return (
                    <li class="mb-3">
                        <div class="flex">
                            <Point class="mr-2 mt-1 size-4 min-w-max"/>
                            <div class="flex-1">
                                {isExpandable ? (
                                    <button 
                                        class="milestone-toggle text-left w-full group"
                                        data-target={`other-${index}`}
                                        type="button"
                                    >
                                        <span set:html={content} class="text-base font-normal text-gray-200 text-balance group-hover:text-sky-200 transition-colors"/>
                                        <svg class="inline-block ml-2 w-4 h-4 transition-transform duration-200 chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                        </svg>
                                    </button>
                                ) : (
                                    <span set:html={content} class="text-base font-normal text-gray-200 text-balance"/>
                                )}
                                
                                {isExpandable && (
                                    <ul id={`other-${index}`} class="sublist hidden mt-2 ml-4 space-y-2">
                                        {milestone.details.map((detail) => (
                                            <li class="flex">
                                                <span class="mr-2 text-sky-200/60">→</span>
                                                <span set:html={detail} class="text-sm text-gray-300 text-balance"/>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    </li>
                );
            })}
        </ul>
    </>
)}

<style>
    .dot {
        position: relative;
        top: 0;
        left: -22px;
    }
    
    .milestone-toggle {
        cursor: pointer;
        display: flex;
        align-items: flex-start;
    }
    
    .milestone-toggle.expanded .chevron {
        transform: rotate(180deg);
    }
    
    .sublist {
        animation: slideDown 0.3s ease-out;
    }
    
    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggleButtons = document.querySelectorAll('.milestone-toggle');
        
        toggleButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-target');
                const sublist = document.getElementById(targetId);
                
                if (sublist) {
                    sublist.classList.toggle('hidden');
                    button.classList.toggle('expanded');
                }
            });
        });
    });
</script>